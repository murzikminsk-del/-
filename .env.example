COMPANY_NAME=
LLM__OPENAI_API_KEY=
LLM__DEFAULT_MODEL=gpt-4.1-mini
LLM__REQUEST_TIMEOUT=30.0
LLM__MAX_RETRIES=3
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
DEBUG=false
APP_NAME=rag-document-assistant

# chat
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10
# qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
EMBEDDING_DIM=1536

# RAG
RAG_COLLECTION=rag_block_03
RAG_COLLECTION_BARE=rag_block_03_bare
RAG_LLM_MODEL=gpt-4o-mini
RAG_TOP_K=3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SCORE_THRESHOLD=0.3